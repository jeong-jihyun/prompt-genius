{
  "manifest_version": 3,
  "name": "PromptGenius - AI Prompt Generator",
  "version": "2.9.1",
  "description": "Turn plain requirements into expert AI prompts. Claude, Ollama, Groq & multi-agent support. Save and inject into any webpage.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open PromptGenius"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "clipboardWrite",
    "clipboardRead",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://api.together.xyz/*",
    "https://openai.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}